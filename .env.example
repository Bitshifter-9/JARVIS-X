# ══ App ═══════════════════════════════════════════════
JARVIS_ENV=local                      # local | cloud | demo
JARVIS_LOG_LEVEL=INFO
JARVIS_BASE_URL=http://localhost:8000
JARVIS_TIMEZONE=Asia/Kolkata

# ══ Database ══════════════════════════════════════════
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5433/jarvis

# ══ Auth — we are our own OAuth2 server (Alexa linking) ═
# generate: openssl rand -hex 32
JARVIS_JWT_SECRET=
JARVIS_ACCESS_TOKEN_TTL_MINUTES=15
JARVIS_REFRESH_TOKEN_TTL_DAYS=30
JARVIS_OAUTH_ISSUER=https://jarvis.example.com

# ══ LLM cascade ═══════════════════════════════════════
# Order is per call class; see apps/api/jarvis/llm/router.py
JARVIS_GROQ_API_KEY=
JARVIS_GROQ_MODEL=openai/gpt-oss-120b

JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-3.6-flash          # extraction: native JSON-schema mode

JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_FREE_MODEL=z-ai/glm-5.2:free
JARVIS_OPENROUTER_PAID_MODEL=anthropic/claude-haiku-4.5
JARVIS_OPENROUTER_FREE_MODEL2=meta-llama/llama-3.3-70b-instruct:free
# Cerebras: a generous free tier (cloud.cerebras.ai). Fast Llama models.
JARVIS_CEREBRAS_API_KEY=
JARVIS_CEREBRAS_MODEL=cerebras/llama-3.3-70b
# A generic OpenAI-compatible gateway (a LiteLLM proxy, vLLM, OpenAI, …). Point one key
# at everything: it is tried first in every cascade.
JARVIS_GATEWAY_BASE_URL=
JARVIS_GATEWAY_API_KEY=
JARVIS_GATEWAY_MODEL=gpt-4o-mini
JARVIS_GATEWAY_IS_PAID=false

# Optional local dev only. NEVER required — the Mac may be offline.
JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.1:8b

# Embeddings run on the VPS (CPU). 384-dim.
JARVIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ══ Budget guard ══════════════════════════════════════
# With this false the whole system must still work on free tiers alone.
# There is a test asserting exactly that.
JARVIS_ENABLE_PAID_LLM=false
JARVIS_MONTHLY_BUDGET_INR=2000
JARVIS_LLM_BUDGET_INR=800

# ══ Agent budgets (enforced outside the model) ════════
JARVIS_MAX_STEPS=8
JARVIS_MAX_REPLANS=2
JARVIS_MAX_TOKENS_PER_RUN=20000
JARVIS_MAX_RUN_SECONDS=180
JARVIS_MAX_NOTIFICATIONS_PER_DAY=20
JARVIS_MAX_CALLS_PER_DAY=3
JARVIS_QUIET_HOURS=22:30-07:00

# ══ Connectors ════════════════════════════════════════
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_OWNER_CHAT_ID=

JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_GMAIL_POLL_SECONDS=60

JARVIS_SLACK_SIGNING_SECRET=
JARVIS_SLACK_BOT_TOKEN=

JARVIS_CANVAS_BASE_URL=
JARVIS_CANVAS_TOKEN=

JARVIS_WHATSAPP_PHONE_NUMBER_ID=
JARVIS_WHATSAPP_TOKEN=
JARVIS_WHATSAPP_TEMPLATE_NAME=jarvis_deadline_alert

JARVIS_TWILIO_ACCOUNT_SID=
JARVIS_TWILIO_AUTH_TOKEN=
JARVIS_TWILIO_FROM_NUMBER=

JARVIS_OPENCLAW_SERVICE_TOKEN=

# ══ YouTube pipeline ══════════════════════════════════
# Pexels b-roll is optional — without a key videos render captions on a dark background.
# Free key: https://www.pexels.com/api/
JARVIS_PEXELS_API_KEY=
# Voices: `uv run edge-tts --list-voices` (e.g. en-IN-PrabhatNeural)
JARVIS_YOUTUBE_TTS_VOICE=en-US-ChristopherNeural
# Imagery for videos. "auto" uses local SDXL + SDXL-Lightning when its weights are
# present (native 768x1344 — the free hosted tiers cap near 576px and look soft),
# and falls back to the keyless remote service. "remote" never runs the local model.
#   uv pip install diffusers accelerate safetensors
#   uv run python -c "from huggingface_hub import snapshot_download, hf_hub_download; \
#     snapshot_download('stabilityai/stable-diffusion-xl-base-1.0', \
#       allow_patterns=['*.json','*.txt','**/*fp16.safetensors']); \
#     hf_hub_download('ByteDance/SDXL-Lightning','sdxl_lightning_4step_lora.safetensors')"
JARVIS_IMAGE_BACKEND=auto
JARVIS_LOCAL_IMAGE_TIMEOUT_MINUTES=25
# Optional hosted fallback. Token: https://huggingface.co/settings/tokens
JARVIS_HUGGINGFACE_API_KEY=
# With a topic set, the video worker renders one Short, refreshes analytics, and
# sweeps comments every day at this hour (in JARVIS_TIMEZONE).
JARVIS_YOUTUBE_DAILY_TOPIC=
JARVIS_YOUTUBE_DAILY_HOUR=9
# YouTube forces uploads from unaudited API projects to private regardless.
JARVIS_YOUTUBE_PRIVACY=private
# Avatar mode: upload assets with scripts/upload_avatar_assets.py, install the models
# with `uv sync --extra avatar`, then point this at a lip-sync CLI. Placeholders
# {video} {audio} {out} are filled in per render. Empty = b-roll visuals.
# The repo ships a SadTalker adapter (see scripts/sadtalker_lipsync.sh for setup):
# JARVIS_YOUTUBE_LIPSYNC_CMD=bash scripts/sadtalker_lipsync.sh {video} {audio} {out}
JARVIS_YOUTUBE_LIPSYNC_CMD=
# Homebrew's core ffmpeg has no libass (captions cannot burn); install ffmpeg-full
# (bottled) and point here at it. ffprobe resolves from the same directory.
JARVIS_FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg

# ══ Push (Android, FCM HTTP v1) ═══════════════════════
# Firebase console → Project settings → Service accounts → Generate new private key
JARVIS_FCM_CREDENTIALS_PATH=
JARVIS_FCM_PROJECT_ID=
# Firebase console → Project settings → General → your Android app (package dev.jarvisx.jarvis_x)
JARVIS_FCM_API_KEY=
JARVIS_FCM_APP_ID=
JARVIS_FCM_SENDER_ID=

# ══ "Hey Jarvis" on the phone (Picovoice, on-device) ══
# console.picovoice.ai → AccessKey (free for personal use)
JARVIS_PICOVOICE_ACCESS_KEY=

# ══ Browser worker (cloud-side, Mac-independent) ══════
JARVIS_BROWSER_HEADLESS=true
JARVIS_BROWSER_TIMEOUT_SECONDS=30

# ══ Evidence storage ══════════════════════════════════
JARVIS_EVIDENCE_BACKEND=local         # local | r2
JARVIS_R2_ENDPOINT=
JARVIS_R2_ACCESS_KEY_ID=
JARVIS_R2_SECRET_ACCESS_KEY=
JARVIS_R2_BUCKET=jarvis-evidence

# ══ Slack (phase 5.1) ═════════════════════════════════
JARVIS_SLACK_BOT_TOKEN=
# From the app's Basic Information page. Unset = the webhook rejects every request.
JARVIS_SLACK_SIGNING_SECRET=

# ══ Google Classroom (phase 5.2) ══════════════════════
# No key of its own: connect with
#   GET /v1/connectors/google/authorize?include_classroom=true

# ══ Canvas LMS (phase 5.3) ════════════════════════════
JARVIS_CANVAS_BASE_URL=
JARVIS_CANVAS_API_TOKEN=

# ══ WhatsApp Cloud API (phase 5.4) ════════════════════
JARVIS_WHATSAPP_PHONE_NUMBER_ID=
JARVIS_WHATSAPP_ACCESS_TOKEN=
JARVIS_WHATSAPP_VERIFY_TOKEN=

# ══ Twilio voice escalation (phase 5.5) ═══════════════
JARVIS_TWILIO_ACCOUNT_SID=
JARVIS_TWILIO_AUTH_TOKEN=
JARVIS_TWILIO_FROM_NUMBER=
JARVIS_MAX_CALLS_PER_DAY=3

# ══ OpenClaw adapter (phase 5.6) ══════════════════════
# The only secret that container holds. It buys the right to post an untrusted
# event and nothing else — no database credentials ever reach the adapter.
JARVIS_OPENCLAW_SHARED_SECRET=

# ══ Alexa (phase 4) ═══════════════════════════════════
JARVIS_ALEXA_SKILL_ID=
# Never set this to false outside local development: it disables the check that the
# request actually came from Amazon.
JARVIS_ALEXA_VERIFY_SIGNATURE=true

# ══ Voice ═════════════════════════════════════════════
# One neural voice everywhere (edge-tts, free, no key). GET /v1/tts/voices for options.
JARVIS_TTS_VOICE=en-GB-RyanNeural

# ══ Deploy ════════════════════════════════════════════
# Your public hostname; Caddy issues the certificate for it. Set JARVIS_BASE_URL to match.
JARVIS_DOMAIN=jarvis.example.com
# Production Postgres password (compose uses it for both sides). Empty = 'jarvis' — fine
# only because Postgres is never exposed outside the compose network.
POSTGRES_PASSWORD=

# ══ Kill switch ═══════════════════════════════════════
JARVIS_GLOBAL_PAUSE=false
