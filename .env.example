# ── App ────────────────────────────────────────────────
JARVIS_ENV=local                      # local | cloud | demo
JARVIS_LOG_LEVEL=INFO
JARVIS_BASE_URL=http://localhost:8000

# ── Database ───────────────────────────────────────────
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# ── Auth (generate: openssl rand -hex 32) ──────────────
JARVIS_JWT_SECRET=
JARVIS_ACCESS_TOKEN_TTL_MINUTES=15
JARVIS_REFRESH_TOKEN_TTL_DAYS=30

# ── LLM routing ────────────────────────────────────────
# Order of preference for non-extraction calls.
JARVIS_LLM_CHAT_PROVIDER=mac_relay    # mac_relay | ollama_local | anthropic
JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.1:8b

# Paid extraction model. Set ENABLE_PAID_LLM=false and the system
# must still work end to end, only with weaker extraction. That is a test.
JARVIS_ENABLE_PAID_LLM=false
JARVIS_ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
JARVIS_ANTHROPIC_MONTHLY_BUDGET_USD=2.00

# ── Agent budgets (enforced outside the model) ─────────
JARVIS_MAX_STEPS=8
JARVIS_MAX_REPLANS=2
JARVIS_MAX_TOKENS_PER_RUN=20000
JARVIS_MAX_RUN_SECONDS=180
JARVIS_MAX_NOTIFICATIONS_PER_DAY=20

# ── Connectors ─────────────────────────────────────────
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_OWNER_CHAT_ID=
JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_GMAIL_POLL_SECONDS=60

# ── Push ───────────────────────────────────────────────
JARVIS_FCM_CREDENTIALS_PATH=

# ── Evidence storage ───────────────────────────────────
JARVIS_EVIDENCE_BACKEND=local         # local | r2
JARVIS_R2_ENDPOINT=
JARVIS_R2_ACCESS_KEY_ID=
JARVIS_R2_SECRET_ACCESS_KEY=
JARVIS_R2_BUCKET=jarvis-evidence

# ── Kill switch ────────────────────────────────────────
JARVIS_GLOBAL_PAUSE=false
