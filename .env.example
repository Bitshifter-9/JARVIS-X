# ══ App ═══════════════════════════════════════════════
JARVIS_ENV=local                      # local | cloud | demo
JARVIS_LOG_LEVEL=INFO
JARVIS_BASE_URL=http://localhost:8000
JARVIS_TIMEZONE=Asia/Kolkata

# ══ Database ══════════════════════════════════════════
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5433/jarvis

# ══ Auth — we are our own OAuth2 server (Alexa linking) ═
# generate: openssl rand -hex 32
JARVIS_JWT_SECRET=
JARVIS_ACCESS_TOKEN_TTL_MINUTES=15
JARVIS_REFRESH_TOKEN_TTL_DAYS=30
JARVIS_OAUTH_ISSUER=https://jarvis.example.com

# ══ LLM cascade ═══════════════════════════════════════
# Order is per call class; see apps/api/jarvis/llm/router.py
JARVIS_GROQ_API_KEY=
JARVIS_GROQ_MODEL=llama-3.3-70b-versatile

JARVIS_GEMINI_API_KEY=
JARVIS_GEMINI_MODEL=gemini-2.5-flash          # extraction: native JSON-schema mode

JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_FREE_MODEL=deepseek/deepseek-chat-v3:free
JARVIS_OPENROUTER_PAID_MODEL=anthropic/claude-haiku-4.5

# Optional local dev only. NEVER required — the Mac may be offline.
JARVIS_OLLAMA_HOST=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=llama3.1:8b

# Embeddings run on the VPS (CPU). 384-dim.
JARVIS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ══ Budget guard ══════════════════════════════════════
# With this false the whole system must still work on free tiers alone.
# There is a test asserting exactly that.
JARVIS_ENABLE_PAID_LLM=false
JARVIS_MONTHLY_BUDGET_INR=2000
JARVIS_LLM_BUDGET_INR=800

# ══ Agent budgets (enforced outside the model) ════════
JARVIS_MAX_STEPS=8
JARVIS_MAX_REPLANS=2
JARVIS_MAX_TOKENS_PER_RUN=20000
JARVIS_MAX_RUN_SECONDS=180
JARVIS_MAX_NOTIFICATIONS_PER_DAY=20
JARVIS_MAX_CALLS_PER_DAY=3
JARVIS_QUIET_HOURS=22:30-07:00

# ══ Connectors ════════════════════════════════════════
JARVIS_TELEGRAM_BOT_TOKEN=
JARVIS_TELEGRAM_OWNER_CHAT_ID=

JARVIS_GOOGLE_CLIENT_ID=
JARVIS_GOOGLE_CLIENT_SECRET=
JARVIS_GMAIL_POLL_SECONDS=60

JARVIS_SLACK_SIGNING_SECRET=
JARVIS_SLACK_BOT_TOKEN=

JARVIS_CANVAS_BASE_URL=
JARVIS_CANVAS_TOKEN=

JARVIS_WHATSAPP_PHONE_NUMBER_ID=
JARVIS_WHATSAPP_TOKEN=
JARVIS_WHATSAPP_TEMPLATE_NAME=jarvis_deadline_alert

JARVIS_TWILIO_ACCOUNT_SID=
JARVIS_TWILIO_AUTH_TOKEN=
JARVIS_TWILIO_FROM_NUMBER=

JARVIS_OPENCLAW_SERVICE_TOKEN=

# ══ Push (Android) ════════════════════════════════════
JARVIS_FCM_CREDENTIALS_PATH=

# ══ Browser worker (cloud-side, Mac-independent) ══════
JARVIS_BROWSER_HEADLESS=true
JARVIS_BROWSER_TIMEOUT_SECONDS=30

# ══ Evidence storage ══════════════════════════════════
JARVIS_EVIDENCE_BACKEND=local         # local | r2
JARVIS_R2_ENDPOINT=
JARVIS_R2_ACCESS_KEY_ID=
JARVIS_R2_SECRET_ACCESS_KEY=
JARVIS_R2_BUCKET=jarvis-evidence

# ══ Alexa (phase 4) ═══════════════════════════════════
JARVIS_ALEXA_SKILL_ID=

# ══ Kill switch ═══════════════════════════════════════
JARVIS_GLOBAL_PAUSE=false
